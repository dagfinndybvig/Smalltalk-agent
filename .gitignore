# Live image state - never commit
*.image
*.changes
*.sources
PharoDebug.log

# VM and launchers (regenerable: curl -sS -L https://get.pharo.org/64/stable+vm | sh)
pharo-vm/
pharo
pharo-ui
pharo-local

# Image snapshots (whole-world backups)
snapshots/
*.image.bak*
*.changes.bak*

# Scratch
*.json.tmp
# Windows reserved device names accidentally materialized as files
# (e.g. `foo > nul` under Git Bash creates a literal file named nul)
nul
# VM console redirection artifacts (held open while the VM runs)
stderr
stdout
# Python bytecode cache (created when running gen_*.py)
__pycache__/
# Mistral-brand desktop theme - kept private (copyright), never publish.
# Lives only in the local image, on disk, and on the local branch
# mistral-theme.
src/MistralDesktop/
# Cat wallpaper pipeline and derived images (same privacy as the theme)
gen_wallpaper.py
wallpaper.png
cat-logo.png
pharo-banner.png
