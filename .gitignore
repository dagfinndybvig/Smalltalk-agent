# Live image state - never commit
*.image
*.changes
*.sources
PharoDebug.log

# VM and launchers (regenerable: curl -sS -L https://get.pharo.org/64/stable+vm | sh)
pharo-vm/
pharo
pharo-ui
pharo-local

# Image snapshots (whole-world backups)
snapshots/
*.image.bak*
*.changes.bak*

# Scratch
*.json.tmp
# Windows reserved device names accidentally materialized as files
# (e.g. `foo > nul` under Git Bash creates a literal file named nul)
nul
# VM console redirection artifacts (held open while the VM runs)
stderr
stdout
